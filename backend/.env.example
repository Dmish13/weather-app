# OpenWeatherMap API key (https://openweathermap.org/api)
API_KEY=your_openweathermap_api_key

# Brevo (Sendinblue) transactional email API key (https://app.brevo.com/)
BREVO_API_KEY=your_brevo_api_key

# Brevo contact list ID for newsletter subscribers
BREVO_LIST_ID=your_brevo_list_id

# Secret token to authorize cron job requests (generate a random string)
CRON_SECRET=your_cron_secret

# Frontend URL used in email links (no trailing slash)
# Examples:
#   GitHub Pages:  https://dmish13.github.io/weather-app/frontend
#   Custom domain: https://weather.yourdomain.com
FRONTEND_URL=https://dmish13.github.io/weather-app/frontend

# Port the server listens on (Vercel ignores this)
PORT=9000
